plugins {
    id 'nf-wave'
    id 'nf-amazon'
}

wave {
    enabled = true
}

fusion {
    enabled = true
    exportStorageCredentials = true
}

process {
    executor = 'awsbatch'
    queue    = 'nf-main-queue'
    
    // Default resource requests
    cpus   = 1
    memory = '2 GB'

    // Error strategy: retry on transient AWS Batch issues
    errorStrategy = { task.exitStatus in [130, 137, 143, 151] ? 'retry' : 'finish' }
    maxRetries = 3

    withName: FASTQC {
        container = 'biocontainers/fastqc:v0.11.9_cv8'
    }

    withName: MULTIQC {
        // Updated to a stable version for reproducibility
        container = 'multiqc/multiqc:v1.14'
    }
}

// AWS Specific Configuration
aws {
    region = 'us-east-1'
    batch {
        // Ensures Nextflow waits for the job to complete in the cloud
        volumes = '/fusion'
    }
}

// Global parameters and Work Directory
workDir = 's3://ns-bioinformatics/work'

params {
    reads  = 's3://ns-bioinformatics/inputs/dataset.fastq'
    outdir = 's3://ns-bioinformatics/results'
}